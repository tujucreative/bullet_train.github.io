#!/usr/bin/env ruby
# Builds the static docs site. Usage: bin/build [--base-path P] [--out DIR]
ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "docs_site"
require "optparse"

options = {}
OptionParser.new do |parser|
  parser.banner = "Usage: bin/build [--base-path P] [--out DIR]"
  parser.on("--base-path P", "URL prefix the site is served under (default: #{DocsSite::Config::DEFAULT_BASE_PATH})") { |value| options[:base_path] = value }
  parser.on("--out DIR", "Output directory, replaced on every build; must be empty, new or a previous build (default: _site)") { |value| options[:out_dir] = File.expand_path(value) }
end.parse!

config = DocsSite::Config.new(**options)
begin
  count = DocsSite::Builder.new(config: config).build
  puts "Built #{count} pages into #{config.out_dir}"
rescue DocsSite::BuildError => error
  warn error.message
  exit 1
end
