#!/usr/bin/env ruby
# Refreshes src/docs from upstream bullet_train-core. Usage: bin/sync-docs [REF]
ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "docs_site"
require "open3"
require "tmpdir"

ref = ARGV.fetch(0, "v1.45.1")
config = DocsSite::Config.new

DocsSite::CLI.run do
  Dir.mktmpdir("bullet_train-core") do |dir|
    unless system("git", "clone", "--depth", "1", "--branch", ref, DocsSite::Sync::REPO, dir)
      raise DocsSite::BuildError, "Could not clone #{DocsSite::Sync::REPO} at #{ref}"
    end
    sha, status = Open3.capture2("git", "-C", dir, "rev-parse", "HEAD")
    raise DocsSite::BuildError, "Could not read the commit sha of the clone" unless status.success?

    DocsSite::Sync.new(config: config).call(upstream_dir: dir, ref: ref, sha: sha.strip)
  end
end
