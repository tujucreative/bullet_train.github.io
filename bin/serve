#!/usr/bin/env ruby
# Builds the docs site with no base path and serves it locally. Usage: bin/serve [PORT]
ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "docs_site"
require "webrick"

port = Integer(ARGV.fetch(0, "4000"))
config = DocsSite::Config.new(base_path: "", out_dir: File.join(DocsSite::ROOT, "_site"))
begin
  count = DocsSite::Builder.new(config: config).build
  puts "Built #{count} pages into #{config.out_dir}"
rescue DocsSite::BuildError => error
  warn error.message
  exit 1
end

server = WEBrick::HTTPServer.new(Port: port, DocumentRoot: config.out_dir)
trap("INT") { server.shutdown }
trap("TERM") { server.shutdown }
puts "Serving #{config.out_dir} at http://localhost:#{port}/docs/"
server.start
